{
  "expo": {
    "name": "logger-rn-example",
    "slug": "logger-rn-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "loggerrnexample",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emit.loggerrnexample"
    },
    "android": {
      "package": "com.emit.loggerrnexample"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
