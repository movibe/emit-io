{
  "name": "@emit/react-native",
  "version": "1.0.0",
  "description": "React Native bindings for @emit/logger — hooks, provider, AppState + navigation tracking",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=browser --format=esm --external=react --external=react-native --external=@react-navigation/native --external=@emit/logger && bun build ./src/index.ts --target=browser --format=cjs --outfile=dist/index.cjs --external=react --external=react-native --external=@react-navigation/native --external=@emit/logger",
    "build:types": "npx tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "@emit/logger": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emit/logger": "workspace:*",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "@react-navigation/native": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emit-logger/emit.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
