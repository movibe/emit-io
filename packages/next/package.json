{
  "name": "emit-io-next",
  "version": "1.0.5",
  "description": "Next.js bindings for emit-io — middleware, route handlers, RSC support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=node --format=esm --external=next --external=emit-io-core --minify && bun build ./src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --external=next --external=emit-io-core --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "emit-io-core": "^1.0.5",
    "next": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "emit-io-core": "workspace:*",
    "@types/node": "^20.11.19",
    "next": "^15.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
