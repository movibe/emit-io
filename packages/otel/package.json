{
  "name": "@emit-io/otel",
  "version": "1.0.0",
  "description": "OpenTelemetry bridge for @emit-io/core — emit OTel spans + logs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.cjs" }
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=node --format=esm --external=@opentelemetry/api --external=@emit-io/core --minify && bun build ./src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --external=@opentelemetry/api --external=@emit-io/core --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "@emit-io/core": "^1.0.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/api-logs": "^0.50.0"
  },
  "devDependencies": {
    "@emit-io/core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.50.0",
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
