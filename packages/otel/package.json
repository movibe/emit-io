{
  "name": "emit-io-otel",
  "version": "2.0.0",
  "description": "OpenTelemetry bridge for emit-io — emit OTel spans + logs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=node --external:@opentelemetry/api --external:@opentelemetry/api-logs --external:emit-io-core --minify && esbuild src/index.ts --bundle --outfile=dist/index.cjs --format=cjs --platform=node --external:@opentelemetry/api --external:@opentelemetry/api-logs --external:emit-io-core --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "emit-io-core": "^2.0.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/api-logs": "^0.50.0"
  },
  "devDependencies": {
    "emit-io-core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.50.0",
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git",
    "directory": "packages/otel"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "observability",
    "logging",
    "analytics",
    "typescript",
    "emit-io"
  ],
  "bugs": {
    "url": "https://github.com/movibe/emit-io/issues"
  },
  "homepage": "https://github.com/movibe/emit-io#readme",
  "author": "Movibe",
  "license": "MIT"
}
