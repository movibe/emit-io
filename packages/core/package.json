{
  "name": "emit-io-core",
  "version": "1.0.6",
  "description": "A flexible and type-safe logging system for JavaScript/TypeScript applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.worker.js"
      },
      "edge-light": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.worker.js"
      },
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.browser.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/test-utils.d.ts",
        "default": "./dist/test-utils.js"
      },
      "require": {
        "types": "./dist/test-utils.d.ts",
        "default": "./dist/test-utils.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=node --format=esm --minify && bun build ./src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --minify && bun build ./src/index.ts --target=browser --format=esm --outfile=dist/index.browser.js --minify && cp dist/index.browser.js dist/index.worker.js && bun build ./src/test-utils.ts --outdir=dist --target=node --format=esm --minify && bun build ./src/test-utils.ts --target=node --format=cjs --outfile=dist/test-utils.cjs --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git",
    "directory": "packages/core"
  },
  "keywords": [
    "logger",
    "analytics",
    "typescript",
    "logging",
    "events",
    "observability",
    "emit-io",
    "transport",
    "type-safe",
    "opentelemetry"
  ],
  "author": "Movibe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/movibe/emit-io/issues"
  },
  "homepage": "https://github.com/movibe/emit-io#readme",
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "consola": "3.4.2",
    "eslint": "^8.56.0",
    "pino": "10.3.1",
    "typescript": "^5.3.3",
    "winston": "3.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
