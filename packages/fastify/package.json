{
  "name": "@emit-io/fastify",
  "version": "1.0.0",
  "description": "Fastify plugin for @emit-io/core — per-request logging, request id, hook timings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=node --format=esm --external=fastify --external=fastify-plugin --external=@emit-io/core && bun build ./src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --external=fastify --external=fastify-plugin --external=@emit-io/core",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "@emit-io/core": "^1.0.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "@emit-io/core": "workspace:*",
    "@types/node": "^20.11.19",
    "fastify": "^5.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emit-io/emit.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
