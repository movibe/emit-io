{
  "name": "emit-io-fastify",
  "version": "1.0.6",
  "description": "Fastify plugin for emit-io — per-request logging, request id, hook timings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=node --external:fastify --external:fastify-plugin --external:emit-io-core --minify && esbuild src/index.ts --bundle --outfile=dist/index.cjs --format=cjs --platform=node --external:fastify --external:fastify-plugin --external:emit-io-core --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "emit-io-core": "^1.0.6",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "emit-io-core": "workspace:*",
    "@types/node": "^20.11.19",
    "fastify": "^5.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git",
    "directory": "packages/fastify"
  },
  "keywords": [
    "fastify",
    "server",
    "logging",
    "analytics",
    "typescript",
    "observability",
    "emit-io"
  ],
  "bugs": {
    "url": "https://github.com/movibe/emit-io/issues"
  },
  "homepage": "https://github.com/movibe/emit-io#readme",
  "author": "Movibe",
  "license": "MIT"
}
