{
  "name": "emit-io-hono",
  "version": "1.0.6",
  "description": "Hono middleware for emit-io — request id, child logger, timings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=node --external:hono --external:emit-io-core --minify && esbuild src/index.ts --bundle --outfile=dist/index.cjs --format=cjs --platform=node --external:hono --external:emit-io-core --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "emit-io-core": "^1.0.6",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "emit-io-core": "workspace:*",
    "@types/node": "^20.11.19",
    "hono": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
