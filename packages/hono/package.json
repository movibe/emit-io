{
  "name": "@emitio/hono",
  "version": "1.0.0",
  "description": "Hono middleware for @emitio/core — request id, child logger, timings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=node --format=esm --external=hono --external=@emitio/core && bun build ./src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --external=hono --external=@emitio/core",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "vitest run",
    "prepack": "bun run build:all"
  },
  "peerDependencies": {
    "@emitio/core": "^1.0.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@emitio/core": "workspace:*",
    "@types/node": "^20.11.19",
    "hono": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emit-logger/emit.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
