{
  "name": "@emit-io/codegen",
  "version": "1.0.0",
  "description": "CLI code generator for @emit-io/core — define events in YAML, get typed TypeScript tracker",
  "type": "module",
  "bin": {
    "logger-codegen": "./dist/index.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=node --format=esm --minify",
    "build:types": "bun x tsc --emitDeclarationOnly",
    "build:all": "bun run build && bun run build:types",
    "test": "bun test",
    "prepare": "bun run build:all"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movibe/emit-io.git"
  },
  "author": "Movibe",
  "license": "MIT"
}
