{
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/react-native",
    "packages/codegen",
    "packages/fastify",
    "packages/next",
    "packages/hono",
    "packages/otel"
  ],
  "scripts": {
    "build": "bun run --filter @emitio/core build:all && bun run --filter @emitio/react build:all && bun run --filter @emitio/react-native build:all && bun run --filter @emitio/next build:all && bun run --filter @emitio/fastify build:all && bun run --filter @emitio/hono build:all && bun run --filter @emitio/otel build:all && bun run --filter @emitio/codegen build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx packages/core/bench/index.ts",
    "bench:compare": "tsx packages/core/bench/compare.ts",
    "lint": "bun run --filter @emitio/core lint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@vitest/coverage-v8": "^2.1.0",
    "pino": "^9.0.0",
    "tinybench": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0",
    "winston": "^3.13.0"
  },
  "name": "",
  "version": ""
}
