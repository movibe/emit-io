{
  "private": true,
  "workspaces": ["packages/core", "packages/react", "packages/codegen", "packages/fastify", "packages/next"],
  "scripts": {
    "build": "npm -w packages/core run build:all && npm -w packages/core run build:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx packages/core/bench/index.ts",
    "bench:compare": "tsx packages/core/bench/compare.ts",
    "lint": "npm -w packages/core run lint"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tinybench": "^3.0.0",
    "tsx": "^4.19.0",
    "pino": "^9.0.0",
    "winston": "^3.13.0"
  }
}
